              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "MCP Error Rate (7d)",
          "layout": { "column": 5, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT percentage(count(*), WHERE success = false) AS 'Error %' WHERE tool LIKE 'mcp__%' SINCE 7 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Unique MCP Users (7d)",
          "layout": { "column": 9, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT uniqueCount(developer) AS 'Users' WHERE tool LIKE 'mcp__%' SINCE 7 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Top MCP Servers (7d)",
          "layout": { "column": 1, "row": 7, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT count(*) AS 'Calls' WHERE tool LIKE 'mcp__%' FACET aparse(tool, 'mcp__*__%') AS 'MCP Server' SINCE 7 days ago LIMIT 25"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "MCP Tools (7d)",
          "layout": { "column": 5, "row": 7, "width": 4, "height": 3 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT count(*) AS 'Calls', filter(count(*), WHERE success = false) AS 'Errors', uniqueCount(developer) AS 'Users' WHERE tool LIKE 'mcp__%' FACET aparse(tool, 'mcp__*__%') AS 'MCP Server', aparse(tool, 'mcp__%__*') AS 'Tool' SINCE 7 days ago LIMIT 50"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "MCP Servers Over Time (7d)",
          "layout": { "column": 9, "row": 7, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT count(*) WHERE tool LIKE 'mcp__%' FACET aparse(tool, 'mcp__*__%') AS 'MCP Server' SINCE 7 days ago TIMESERIES 1 day LIMIT 10"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false },
            "yAxisLeft": { "zero": true }
          }
        }
      ]
    },
    {
      "name": "Team Leaderboard",
      "description": null,
      "widgets": [
        {
          "title": "Activity Leaderboard (7d)",
          "layout": { "column": 1, "row": 1, "width": 6, "height": 4 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT uniqueCount(dateOf(timestamp)) AS 'Active Days', uniqueCount(session_id) AS 'Sessions', count(*) AS 'Tool Calls', percentage(count(*), WHERE success = true) AS 'Success %' FACET developer SINCE 7 days ago LIMIT 60"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Outcome Leaderboard (7d)",
          "layout": { "column": 7, "row": 1, "width": 6, "height": 4 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT count(*) AS 'Tasks', sum(estimated_cost_usd) AS 'Cost (USD)', sum(lines_added) AS 'Lines Added', percentage(count(*), WHERE tests_passed > 0) AS 'Tests Passing %' FACET developer SINCE 7 days ago LIMIT 60"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Efficiency Score by Developer (7d)",
          "layout": { "column": 1, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM Metric SELECT average(ai.efficiency.score) AS 'Score' FACET developer SINCE 7 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Anti-Patterns by Developer (7d)",
          "layout": { "column": 5, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {

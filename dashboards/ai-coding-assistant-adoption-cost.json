            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Avg Cost per Task by Developer (7d)",
          "layout": { "column": 9, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT average(estimated_cost_usd) AS 'USD / Task' FACET developer SINCE 7 days ago"

{
  "name": "AI Coding Assistant — Adoption & Cost",
  "description": "Org-wide adoption, spend, tool/MCP usage, and team leaderboard built entirely from Preflight events. Works on every supported platform with no additional telemetry.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Adoption",
      "description": null,
      "widgets": [
        {
          "title": "About This Page",
          "layout": { "column": 1, "row": 1, "width": 12, "height": 1 },
          "visualization": { "id": "viz.markdown" },
          "rawConfiguration": {
            "text": "# Adoption\n\nWho is using AI coding assistants, how often, and on which platforms. All widgets read Preflight events (`AiToolCall`, `AiCodingTask`) — no platform-specific telemetry required."
          }
        },
        {
          "title": "Active Developers (30d)",
          "layout": { "column": 1, "row": 2, "width": 3, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT uniqueCount(developer) AS 'Developers' SINCE 30 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Sessions (30d)",
          "layout": { "column": 4, "row": 2, "width": 3, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT uniqueCount(session_id) AS 'Sessions' SINCE 30 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Tool Calls (30d)",
          "layout": { "column": 7, "row": 2, "width": 3, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT count(*) AS 'Tool Calls' SINCE 30 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Tasks Completed (30d)",
          "layout": { "column": 10, "row": 2, "width": 3, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT count(*) AS 'Tasks' SINCE 30 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Daily Active Developers",
          "layout": { "column": 1, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT uniqueCount(developer) AS 'Developers' SINCE 30 days ago TIMESERIES 1 day"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false },
            "yAxisLeft": { "zero": true }
          }
        },
        {
          "title": "Daily Sessions",
          "layout": { "column": 5, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT uniqueCount(session_id) AS 'Sessions' SINCE 30 days ago TIMESERIES 1 day"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false },
            "yAxisLeft": { "zero": true }
          }
        },
        {
          "title": "Platform Mix (30d)",
          "layout": { "column": 9, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.pie" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": true },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT count(*) FACET platform SINCE 30 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Daily Lines of Code",
          "layout": { "column": 1, "row": 8, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(lines_added) AS 'Added', sum(lines_removed) AS 'Removed' SINCE 30 days ago TIMESERIES 1 day"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false },
            "yAxisLeft": { "zero": true }
          }
        },
        {
          "title": "Daily Tool Calls by Platform",
          "layout": { "column": 5, "row": 8, "width": 4, "height": 3 },
          "visualization": { "id": "viz.stacked-bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT count(*) FACET platform SINCE 30 days ago TIMESERIES 1 day"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Active Days per Developer (30d)",
          "layout": { "column": 9, "row": 8, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT uniqueCount(dateOf(timestamp)) AS 'Active Days' FACET developer SINCE 30 days ago LIMIT 50"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        }
      ]
    },
    {
      "name": "Cost",
      "description": null,
      "widgets": [
        {
          "title": "How Cost Is Measured",
          "layout": { "column": 1, "row": 1, "width": 12, "height": 1 },
          "visualization": { "id": "viz.markdown" },
          "rawConfiguration": {
            "text": "# Cost\n\nSpend from `AiCodingTask.estimated_cost_usd` (per-task events, safe to sum). Token and cache widgets read the session-level `ai.cost.*` gauges via latest-per-session subqueries. With `companionMode: true` the `ai.cost.*` gauges are suppressed, so the token/cache widgets go quiet and Claude Code's own OTel metrics become the cost authority — task cost events remain and are tagged `cost_authority: 'external'`."
          }
        },
        {
          "title": "Total Cost (30d)",
          "layout": { "column": 1, "row": 2, "width": 3, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(estimated_cost_usd) AS 'USD' SINCE 30 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Total Cost (7d)",
          "layout": { "column": 4, "row": 2, "width": 3, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(estimated_cost_usd) AS 'USD' SINCE 7 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Avg Cost per Task (7d)",
          "layout": { "column": 7, "row": 2, "width": 3, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT average(estimated_cost_usd) AS 'USD / Task' SINCE 7 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Cache Hit % (7d)",
          "layout": { "column": 10, "row": 2, "width": 3, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM (FROM Metric SELECT latest(ai.cost.tokens_input) AS input, latest(ai.cost.tokens_cache_read) AS cacheRead FACET session_id LIMIT MAX SINCE 7 days ago) SELECT sum(cacheRead) / (sum(input) + sum(cacheRead)) * 100 AS 'Cache Hit %' SINCE 7 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Daily Cost by Developer",
          "layout": { "column": 1, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.stacked-bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(estimated_cost_usd) AS 'USD' FACET developer SINCE 30 days ago TIMESERIES 1 day"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Monthly Cost by Developer",
          "layout": { "column": 5, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.stacked-bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(estimated_cost_usd) AS 'USD' FACET developer SINCE 6 months ago TIMESERIES 1 month"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Cost by Project (30d)",
          "layout": { "column": 9, "row": 5, "width": 4, "height": 3 },
          "visualization": { "id": "viz.pie" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": true },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(estimated_cost_usd) AS 'USD' FACET project_id SINCE 30 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Token Mix (7d)",
          "layout": { "column": 1, "row": 8, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM (FROM Metric SELECT latest(ai.cost.tokens_input) AS input, latest(ai.cost.tokens_output) AS output, latest(ai.cost.tokens_thinking) AS thinking, latest(ai.cost.tokens_cache_read) AS cacheRead FACET session_id LIMIT MAX SINCE 7 days ago) SELECT sum(input) AS 'Input', sum(output) AS 'Output', sum(thinking) AS 'Thinking', sum(cacheRead) AS 'Cache Read' SINCE 7 days ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Daily Token Volume",
          "layout": { "column": 5, "row": 8, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(tokens_used) AS 'Tokens' SINCE 30 days ago TIMESERIES 1 day"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false },
            "yAxisLeft": { "zero": true }
          }
        },
        {
          "title": "Most Expensive Sessions (7d)",
          "layout": { "column": 9, "row": 8, "width": 4, "height": 3 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiCodingTask SELECT sum(estimated_cost_usd) AS 'USD' FACET session_id SINCE 7 days ago LIMIT 10"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        }
      ]
    },
    {
      "name": "Tools & MCP",
      "description": null,
      "widgets": [
        {
          "title": "Top Tools (7d)",
          "layout": { "column": 1, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT count(*) AS 'Calls' FACET tool SINCE 7 days ago LIMIT 25"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Tool Reliability (7d)",
          "layout": { "column": 5, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT count(*) AS 'Calls', filter(count(*), WHERE success = false) AS 'Errors', percentage(count(*), WHERE success = false) AS 'Error %' FACET tool SINCE 7 days ago LIMIT 25"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Daily Tool Errors by Type (7d)",
          "layout": { "column": 9, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.stacked-bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountIds": [],
                "query": "FROM AiToolCall SELECT count(*) AS 'Errors' WHERE success = false FACET error_type SINCE 7 days ago TIMESERIES 1 day"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "MCP Calls (7d)",
          "layout": { "column": 1, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
